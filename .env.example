# Salin file ini menjadi .env lalu isi sesuai kebutuhan.
# Aplikasi ini HANYA berjalan dalam mode nyata — GOOGLE_MAPS_API_KEY dan
# OPENROUTER_API_KEY WAJIB diisi, kalau tidak backend menolak start (fail fast).

# Dibutuhkan (Data Collector Agent mengambil data kompetitor sungguhan lewat MCP server
# yang membungkus Google Places API — lihat backend/mcp_server.py). Kunci yang sama juga
# dipakai frontend (via /api/maps-key) untuk menampilkan peta sebaran kompetitor sungguhan
# (Maps JavaScript API). Aktifkan Places API, Geocoding API, dan Maps JavaScript API pada
# project Google Cloud Anda.
GOOGLE_MAPS_API_KEY=

# Pengaman biaya Google API (lihat README bagian "Batasi Biaya Google API").
# Batas jumlah panggilan Google API (geocode + nearby search + place details
# digabung) per hari, dan jeda minimum antar-request (detik). Ditegakkan di
# dalam backend/mcp_server.py.
GOOGLE_API_DAILY_LIMIT=80
GOOGLE_API_MIN_INTERVAL_SECONDS=3

# Dibutuhkan (Sentiment & Strategy Agent, serta reasoning Data Collector Agent saat
# memutuskan pemanggilan tool MCP, semuanya lewat LLM via OpenRouter: https://openrouter.ai/keys).
# Satu key, bisa akses banyak model dari berbagai provider (OpenAI, Anthropic, Google,
# model gratis, dll). Format OPENROUTER_MODEL: "<provider>/<model>", mis. "openai/gpt-4o-mini",
# "anthropic/claude-3.5-haiku", atau model gratis seperti "meta-llama/llama-3.1-8b-instruct:free".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Human-in-the-loop: berapa lama (detik) pipeline menunggu keputusan approve/reject
# manusia sebelum Strategy Agent boleh jalan, sebelum otomatis dibatalkan.
HITL_TIMEOUT_SECONDS=300

# Opsional
HOST=0.0.0.0
PORT=8000
