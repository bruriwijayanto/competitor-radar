# Salin file ini menjadi .env lalu isi sesuai kebutuhan.
# Mode "mock" (default) berjalan penuh TANPA API key apa pun.

# "mock" atau "real"
APP_MODE=mock

# Dibutuhkan hanya jika APP_MODE=real (untuk mengambil data kompetitor sungguhan)
GOOGLE_MAPS_API_KEY=

# Dibutuhkan hanya jika APP_MODE=real (untuk analisis sentimen & strategi via LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opsional
HOST=0.0.0.0
PORT=8000
