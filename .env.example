# Salin file ini menjadi .env lalu isi sesuai kebutuhan.
# Mode "mock" (default) berjalan penuh TANPA API key apa pun.

# "mock" atau "real"
APP_MODE=mock

# Dibutuhkan hanya jika APP_MODE=real (untuk mengambil data kompetitor sungguhan).
# Kalau diisi, kunci yang sama juga dipakai frontend (via /api/maps-key) untuk
# menampilkan peta sebaran kompetitor sungguhan (Maps JavaScript API) — aktif
# independen dari APP_MODE. Aktifkan Places API, Geocoding API, dan Maps
# JavaScript API pada project Google Cloud Anda.
GOOGLE_MAPS_API_KEY=

# Pengaman biaya Google API (lihat README bagian "Batasi Biaya Google API").
# Batas jumlah panggilan Google API (geocode + nearby search + place details
# digabung) per hari, dan jeda minimum antar-request real-mode (detik).
GOOGLE_API_DAILY_LIMIT=80
GOOGLE_API_MIN_INTERVAL_SECONDS=3

# Dibutuhkan hanya jika APP_MODE=real (untuk analisis sentimen & strategi via LLM).
# Pakai OpenRouter (https://openrouter.ai/keys) — satu key, bisa akses banyak model
# dari berbagai provider (OpenAI, Anthropic, Google, model gratis, dll).
# Format OPENROUTER_MODEL: "<provider>/<model>", mis. "openai/gpt-4o-mini",
# "anthropic/claude-3.5-haiku", atau model gratis seperti "meta-llama/llama-3.1-8b-instruct:free".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Opsional
HOST=0.0.0.0
PORT=8000
