# Salin file ini menjadi .env lalu isi sesuai kebutuhan.
# Mode "mock" (default) berjalan penuh TANPA API key apa pun.

# "mock" atau "real"
APP_MODE=mock

# Dibutuhkan hanya jika APP_MODE=real (untuk mengambil data kompetitor sungguhan).
# Kalau diisi, kunci yang sama juga dipakai frontend (via /api/maps-key) untuk
# menampilkan peta sebaran kompetitor sungguhan (Maps JavaScript API) — aktif
# independen dari APP_MODE. Aktifkan Places API, Geocoding API, dan Maps
# JavaScript API pada project Google Cloud Anda.
GOOGLE_MAPS_API_KEY=

# Dibutuhkan hanya jika APP_MODE=real (untuk analisis sentimen & strategi via LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opsional
HOST=0.0.0.0
PORT=8000
